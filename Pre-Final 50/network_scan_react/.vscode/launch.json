{
    "version": "2.0.0",
    "configurations": [
        {
            "name": "Run Network Scan Project",
            "type": "chrome",
            "request": "launch",
            "url": "http://127.0.0.1:5500/react-basic-mod.html",
            "webRoot": "${workspaceFolder}/frontend",
            "preLaunchTask": "Run Network Scan Project"
        },
        {
            "name": "Stop Network Scan Project",
            "type": "node-terminal",
            "request": "launch",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${workspaceFolder}\\.vscode\\stop-network-scan.ps1\""
        }
    ]
}